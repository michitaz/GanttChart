<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Epic Gantt Chart Access</label>
    <description>Grants access to Epics, Project Stages, and Milestones, and to the Epic Gantt Chart component.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <objectPermissions>
        <object>Epic__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Project_Stage__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Milestone__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <field>Epic__c.Description__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Epic__c.Account__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Project_Stage__c.Display_Order__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Project_Stage__c.Description__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Project_Stage__c.System__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>

    <classAccesses>
        <apexClass>EpicGanttController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <flowAccesses>
        <flow>Add_Project_Stages_And_Milestones</flow>
        <enabled>true</enabled>
    </flowAccesses>

    <tabSettings>
        <tab>Epic__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Project_Stage__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Milestone__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
